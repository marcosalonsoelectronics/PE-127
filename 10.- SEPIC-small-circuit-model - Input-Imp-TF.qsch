  «text (13650,4700) 2.5 7 1 0x1000000 -1 -1 "ï»¿SMALL-SIGNAL MODEL OF SEPIC (CCM)"»
  «text (12150,4000) 1 7 0 0x1000000 -1 -1 "ï»¿.param L1=4.6Âµ r1=10m L2=4.6Âµ r2=10m Cs=10Âµ rs=10m C=47Âµ rc=10m R=1 Io=0"»
  «text (12150,3550) 1 7 0 0x1000000 -1 -1 "ï»¿.param Vi=4  D=0.45"»
  «text (12150,3100) 1 7 0 0x1000000 -1 -1 "ï»¿.param Vo= D*Vi/(  1 - D + (1-D)*r2/R + (D**2/(1-D))*r1/R   )"»
